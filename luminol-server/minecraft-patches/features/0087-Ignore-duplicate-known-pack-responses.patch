From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: libalpm64 <159192189+libalpm64@users.noreply.github.com>
Date: Thu, 30 Jul 2026 13:32:55 -0400
Subject: [PATCH] Speleothem: Ignore duplicate known-pack responses


diff --git a/net/minecraft/server/network/ServerConfigurationPacketListenerImpl.java b/net/minecraft/server/network/ServerConfigurationPacketListenerImpl.java
index b80ff19799e9e05f5709c113ee938f8d01d0acc4..05384a70763a8aab25fc1dfc82cfcfa02f43f439 100644
--- a/net/minecraft/server/network/ServerConfigurationPacketListenerImpl.java
+++ b/net/minecraft/server/network/ServerConfigurationPacketListenerImpl.java
@@ -171,11 +171,16 @@ public class ServerConfigurationPacketListenerImpl extends ServerCommonPacketLis
     @Override
     public void handleSelectKnownPacks(final ServerboundSelectKnownPacks packet) {
         PacketUtils.ensureRunningOnSameThread(packet, this, this.server.packetProcessor());
-        if (this.synchronizeRegistriesTask == null) {
-            throw new IllegalStateException("Unexpected response from client: received pack selection, but no negotiation ongoing");
+        // Speleothem start - Ignore duplicate known-pack responses
+        SynchronizeRegistriesTask task = this.synchronizeRegistriesTask;
+        if (task == null || this.currentTask != task) {
+            LOGGER.debug("Ignoring stale known-pack response from {}", this.gameProfile.name());
+            return;
         }
 
-        this.synchronizeRegistriesTask.handleResponse(packet.knownPacks(), this::send);
+        task.handleResponse(packet.knownPacks(), this::send);
+        this.synchronizeRegistriesTask = null;
+        // Speleothem end - Ignore duplicate known-pack responses
         this.finishCurrentTask(SynchronizeRegistriesTask.TYPE);
     }
 
