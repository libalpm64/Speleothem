diff --git a/net/minecraft/world/level/redstone/NeighborUpdater.java b/net/minecraft/world/level/redstone/NeighborUpdater.java
index 44dbe6f..646de98 100644
--- a/net/minecraft/world/level/redstone/NeighborUpdater.java
+++ b/net/minecraft/world/level/redstone/NeighborUpdater.java
@@ -17,6 +17,19 @@ import org.jspecify.annotations.Nullable;
 public interface NeighborUpdater {
     Direction[] UPDATE_ORDER = new Direction[]{Direction.WEST, Direction.EAST, Direction.DOWN, Direction.UP, Direction.NORTH, Direction.SOUTH};
 
+    // Speleothem - a failed cross-region update must not leave an inventory screen half-open.
+    static void isolateFailedUpdate(final Level level, final BlockPos pos, final Throwable error) {
+        if (level instanceof net.minecraft.server.level.ServerLevel serverLevel) {
+            for (final net.minecraft.server.level.ServerPlayer player : serverLevel.getLocalPlayers()) {
+                if (player.containerMenu != player.inventoryMenu) {
+                    player.closeContainer(org.bukkit.event.inventory.InventoryCloseEvent.Reason.UNLOADED);
+                }
+                player.inventoryMenu.broadcastChanges();
+            }
+        }
+        net.minecraft.server.MinecraftServer.LOGGER.error("Skipping failed neighbor update at {}", pos.toShortString(), error);
+    }
+
     void shapeUpdate(Direction direction, BlockState neighborState, BlockPos pos, BlockPos neighborPos, @Block.UpdateFlags int updateFlags, int updateLimit);
 
     void neighborChanged(BlockPos pos, Block changedBlock, @Nullable Orientation orientation);
@@ -53,7 +66,7 @@ public interface NeighborUpdater {
                 CrashReportCategory.populateBlockDetails(ownCategory, level, pos, currentState);
                 CrashReportCategory neighborCategory = report.addCategory("Neighbor block");
                 CrashReportCategory.populateBlockDetails(neighborCategory, level, neighborPos, neighborState);
-                throw new ReportedException(report);
+                isolateFailedUpdate((level instanceof Level actual) ? actual : null, pos, new ReportedException(report));
             }
         }
     }
@@ -109,7 +122,7 @@ public interface NeighborUpdater {
                 }
             );
             CrashReportCategory.populateBlockDetails(category, level, pos, state);
-            throw new ReportedException(report);
+            isolateFailedUpdate(level, pos, new ReportedException(report));
         }
     }
 }
