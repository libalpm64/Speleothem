Subject: [PATCH] Speleothem: Allow overstacked items inside containers


diff --git a/net/minecraft/world/item/ItemStack.java b/net/minecraft/world/item/ItemStack.java
index 20c4d8ae16d9c8af14321188dbf35e8234eb0891..71d0e394140f2d1539359f6c1a8b0d0b0698e423 100644
--- a/net/minecraft/world/item/ItemStack.java
+++ b/net/minecraft/world/item/ItemStack.java
@@ -323,14 +323,7 @@ public final class ItemStack implements DataComponentHolder, ItemInstance, Chang
     }
 
     private static DataResult<?> validateContainedItemSizes(final Iterable<? extends ItemInstance> items) {
-        for (ItemInstance item : items) {
-            int itemCount = item.count();
-            int maxStackSize = item.getMaxStackSize();
-            if (itemCount > maxStackSize) {
-                return DataResult.error(() -> "Item stack with count of " + itemCount + " was larger than maximum: " + maxStackSize);
-            }
-        }
-
+        // Speleothem - Allow overstacked items inside containers
         return DataResult.success(Unit.INSTANCE);
     }
 
